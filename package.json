{
  "name": "bracken-vale",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun --bun tsc --noEmit && vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "check": "bun --bun tsc --noEmit && bun test",
    "screenshots": "bun run scripts/capture.ts",
    "site:review": "bun run scripts/review-site.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "html-to-image": "^1.11.13",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9",
    "vite": "^7"
  }
}
